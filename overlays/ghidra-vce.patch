+# CAUTION: writing arbitrary values here can take the VPU down with a bus
+# error - some of these registers are addresses the codec block dereferences.
+:stcreg^CC RDS, RS, CB is op=15 & CC & RDS & RS & CB {
+	if (!CC) goto inst_next;
+	CB = RDS;
