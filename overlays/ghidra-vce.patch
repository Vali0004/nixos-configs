+# UNVERIFIED on hardware, unlike the load path: a store executed standalone did
+# not land anywhere in the data RAM window the VPU can see, in any operand
+# arrangement tried.  Stores may target a different space, or need DMA or an
+# enable that a bare two-instruction program does not set up.  Treat the
+# addressing below as inferred, not measured.
+:stb^CC RDS, RS, B is op=12 & CC & RDS & RS & B {
+	if (!CC) goto inst_next;
+	local ea:4; eaddr(ea, RS, B);
+	*[data]:1 ea = RDS:1;
