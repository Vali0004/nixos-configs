--- a/ggml/src/ggml-sycl/common.hpp
+++ b/ggml/src/ggml-sycl/common.hpp
@@ -198,6 +198,11 @@
 // Set to 11, the last size with a clear win.
 #define MMVQ_MAX_BATCH_SIZE_Q4_K  16
 
+// Same for the other reorderable k-quants. mmvq stays flat while the
+// dequantize + oneDNN fallback only catches up slowly, so the crossover is
+// well past the CUDA-inherited 8. Measured per type below.
+#define MMVQ_MAX_BATCH_SIZE_KQUANT  16
+
 static int g_all_sycl_device_count = -1;
 static bool g_ggml_backend_sycl_buffer_type_initialized = false;
 
@@ -703,7 +708,19 @@
         ggml_sycl_get_env("GGML_SYCL_MMVQ_MAX_BATCH", MMVQ_MAX_BATCH_SIZE);
     static const int q4k =
         ggml_sycl_get_env("GGML_SYCL_MMVQ_MAX_BATCH_Q4_K", MMVQ_MAX_BATCH_SIZE_Q4_K);
-    return type == GGML_TYPE_Q4_K ? q4k : base;
+    static const int kq =
+        ggml_sycl_get_env("GGML_SYCL_MMVQ_MAX_BATCH_KQUANT", MMVQ_MAX_BATCH_SIZE_KQUANT);
+    switch (type) {
+        case GGML_TYPE_Q4_K:
+            return q4k;
+        // only these have _switch_ncols kernels instantiated past 8
+        case GGML_TYPE_Q3_K:
+        case GGML_TYPE_Q5_K:
+        case GGML_TYPE_Q6_K:
+            return kq;
+        default:
+            return base;
+    }
 }
 
