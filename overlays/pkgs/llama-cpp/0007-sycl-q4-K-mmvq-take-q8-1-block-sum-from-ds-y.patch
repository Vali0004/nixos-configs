From: llama.cpp SYCL backend
Subject: [PATCH] sycl: q4_K/q5_K mmvq - take the q8_1 block sum from ds.y

--- a/ggml/src/ggml-sycl/vecdotq.hpp
+++ b/ggml/src/ggml-sycl/vecdotq.hpp
@@ -254,6 +254,49 @@
     return dm4f.x() * sumf_d - dm4f.y() * sumf_m;
 }
 
+// Same as above, but takes the q8_1 block sums from block_q8_1.ds.y instead of
+// recomputing them from the quants.
+//
+// dot2 above sums the q8_1 bytes with dp4a(0x01010101, ...). Because one
+// operand is all ones, IGC folds the multiply away and emits a per-byte
+// extract and add chain instead of the dp4a: 16 mov + 6 add3 per output
+// column on Battlemage, 24-35% of the whole kernel. quantize_q8_1 already
+// stores that sum in ds.y, so read it.
+//
+// add_m must be true on exactly one lane per q8_1 block. The lanes sharing a
+// bq8_offset each cover a different quarter of the block, so every one of them
+// would otherwise add the whole-block sum.
+//
+// Note ds.y is the float sum of the inputs, while the old dot2 path summed the
+// rounded quants - so this is very slightly more accurate, not just faster.
+static __dpct_inline__ float vec_dot_q4_K_q8_1_impl_vmmq_s(
+    const int *__restrict__ v, const int *__restrict__ u,
+    const uint8_t *__restrict__ sc, const uint8_t *__restrict__ m,
+    const sycl::half2 &dm4, const float *__restrict__ d8,
+    const float *__restrict__ s8, const bool add_m) {
+
+    float sumf_d = 0.0f;
+    float sumf_m = 0.0f;
+
+#pragma unroll
+    for (int i = 0; i < QR4_K; ++i) {
+        const int v0i = (v[0] >> (4*i)) & 0x0F0F0F0F;
+        const int v1i = (v[1] >> (4*i)) & 0x0F0F0F0F;
+
+        const int dot1 =
+            dpct::dp4a(v1i, u[2 * i + 1],
+                       dpct::dp4a(v0i, u[2 * i + 0], 0)); // SIMD dot product
+
+        sumf_d += d8[i] * (dot1 * sc[i]);
+        sumf_m += add_m ? s8[i] * m[i] : 0.0f;
+    }
+
+    const sycl::float2 dm4f =
+        dm4.convert<float, sycl::rounding_mode::automatic>();
+
+    return dm4f.x() * sumf_d - dm4f.y() * sumf_m;
+}
+
 
 #define VDR_Q5_K_Q8_1_MMVQ 2
 
@@ -296,6 +339,43 @@
