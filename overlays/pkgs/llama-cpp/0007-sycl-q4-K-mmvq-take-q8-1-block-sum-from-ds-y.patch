+// q5_K counterpart of vec_dot_q4_K_q8_1_impl_vmmq_s - see the comment there for
+// why the block sum comes from ds.y instead of dp4a(0x01010101, ...).
+static __dpct_inline__ float vec_dot_q5_K_q8_1_impl_vmmq_s(
+    const int *__restrict__ vl, const int *__restrict__ vh,
+    const int *__restrict__ u, const uint8_t *__restrict__ sc,
+    const uint8_t *__restrict__ m, const sycl::half2 &dm5,
+    const float *__restrict__ d8, const float *__restrict__ s8,
+    const bool add_m) {
+
+    float sumf_d = 0.0f;
+    float sumf_m = 0.0f;
+
+#pragma unroll
+    for (int i = 0; i < QR5_K; ++i) {
+        const int vl0i = (vl[0] >> (4*i)) & 0x0F0F0F0F;
+        const int vl1i = (vl[1] >> (4*i)) & 0x0F0F0F0F;
+
+        const int vh0i = ((vh[0] >> i) << 4) & 0x10101010;
+        const int vh1i = ((vh[1] >> i) << 4) & 0x10101010;
+
+        const int v0i = vl0i | vh0i;
+        const int v1i = vl1i | vh1i;
+
+        const int dot1 =
+            dpct::dp4a(v0i, u[2 * i + 0],
+                       dpct::dp4a(v1i, u[2 * i + 1], 0)); // SIMD dot product
+
+        sumf_d += d8[i] * (dot1 * sc[i]);
+        sumf_m += add_m ? s8[i] * m[i] : 0.0f;
+    }
+
+    const sycl::float2 dm5f =
+        dm5.convert<float, sycl::rounding_mode::automatic>();
+
+    return dm5f.x() * sumf_d - dm5f.y() * sumf_m;
+}
+
 
 #define VDR_Q6_K_Q8_1_MMVQ 1
 
