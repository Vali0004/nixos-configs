--- a/ggml/src/ggml-sycl/common.hpp
+++ b/ggml/src/ggml-sycl/common.hpp
@@ -717,6 +717,12 @@
         case GGML_TYPE_Q3_K:
         case GGML_TYPE_Q5_K:
         case GGML_TYPE_Q6_K:
+        // q4_0/q8_0 were left on the CUDA default of 8 while every k-quant was
+        // raised. That is the format most worth having here: at 9 columns
+        // (MTP n=8, or a couple of parallel slots) q4_0 fell off mmvq into the
+        // dequantise+oneDNN fallback and collapsed - measured 44 -> 4.8 t/s.
+        case GGML_TYPE_Q4_0:
+        case GGML_TYPE_Q8_0:
             return kq;
         default:
             return base;
