From: llama.cpp SYCL backend
Subject: [PATCH] sycl: extend the mmvq crossover to q4_0/q8_0

diff --git a/ggml/src/ggml-sycl/common.hpp b/ggml/src/ggml-sycl/common.hpp
index 9d06429c4..d169b364c 100644
--- a/ggml/src/ggml-sycl/common.hpp
+++ b/ggml/src/ggml-sycl/common.hpp
@@ -704,6 +704,12 @@ static inline int ggml_sycl_mmvq_max_batch(enum ggml_type type) {
         case GGML_TYPE_Q3_K:
         case GGML_TYPE_Q5_K:
         case GGML_TYPE_Q6_K:
+        // q4_0/q8_0 were left on the CUDA default of 8 while every k-quant was
+        // raised. That is the format most worth having here: at 9 columns
+        // (MTP n=8, or a couple of parallel slots) q4_0 fell off mmvq into the
+        // dequantise+oneDNN fallback and collapsed - measured 44 -> 4.8 t/s.
+        case GGML_TYPE_Q4_0:
+        case GGML_TYPE_Q8_0:
             return kq;
         default:
             return base;
