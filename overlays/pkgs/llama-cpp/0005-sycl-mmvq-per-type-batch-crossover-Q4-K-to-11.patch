From: llama.cpp SYCL backend
Subject: [PATCH] sycl: mmvq per-type batch crossover, Q4_K to 11

diff --git a/ggml/src/ggml-sycl/common.hpp b/ggml/src/ggml-sycl/common.hpp
index 49639b2..808819d 100644
--- a/ggml/src/ggml-sycl/common.hpp
+++ b/ggml/src/ggml-sycl/common.hpp
@@ -175,8 +175,24 @@ typedef float dfloat; // dequantize float
 typedef sycl::float2 dfloat2;
 #endif // GGML_SYCL_F16
 
+// Batch size at which mmvq hands over to the dequantize + oneDNN GEMM path.
+// 8 is inherited from CUDA and is the cap for every type whose fused
+// multi-column kernels are only instantiated up to ncols_dst == 8. Raising it
+// globally is a correctness bug: types without those instantiations fall into
+// the single-column fallback, which only handles column 0.
 #define MMVQ_MAX_BATCH_SIZE  8
 
+// Q4_K has its fused kernels instantiated past 8. Measured on Battlemage
+// (B70, Qwen3.6-27B Q4_K_M, same-binary A/B): oneDNN's cost is essentially
+// fixed because it dequantizes the whole weight matrix regardless of batch,
+// while mmvq scales with the column count but flattens out around 12. mmvq
+// wins below that and loses above:
+//   pp9  28.65 -> 35.86  (+25%)
+//   pp11 34.88 -> 37.51  (+7.5%)
+//   pp13 40.96 -> 38.93  (-5%)
+// Set to 11, the last size with a clear win.
+#define MMVQ_MAX_BATCH_SIZE_Q4_K  11
+
 static int g_all_sycl_device_count = -1;
 static bool g_ggml_backend_sycl_buffer_type_initialized = false;
 
@@ -672,6 +688,19 @@ static inline size_t ggml_sycl_mmvq_subgroups() {
     return n;
 }
 
+// Batch size at which mmvq hands over to the dequantize + oneDNN GEMM path.
+// The default is inherited from the CUDA backend and has never been tuned for
+// Intel; oneDNN reaches XMX throughput here, so the best crossover is an
+// empirical question. Can only usefully be lowered: the fused multi-column
+// mmvq kernels are instantiated up to ncols_dst == 8.
+static inline int ggml_sycl_mmvq_max_batch(enum ggml_type type) {
+    static const int base =
+        ggml_sycl_get_env("GGML_SYCL_MMVQ_MAX_BATCH", MMVQ_MAX_BATCH_SIZE);
+    static const int q4k =
+        ggml_sycl_get_env("GGML_SYCL_MMVQ_MAX_BATCH_Q4_K", MMVQ_MAX_BATCH_SIZE_Q4_K);
+    return type == GGML_TYPE_Q4_K ? q4k : base;
+}
+
